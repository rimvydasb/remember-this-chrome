{
  "name": "remember-this-chrome",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension to capture YouTube transcripts and web page text into a local, searchable library.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write --log-level warn \"**/*.{ts,tsx,js,cjs,mjs,json,md}\"",
    "icons": "node scripts/generate-icons.mjs",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json,md}\"",
    "lint": "oxlint --quiet",
    "lint:all": "oxlint",
    "depcruise": "depcruise . --config .dependency-cruiser.cjs --ignore-known --output-type err-long",
    "depcruise:baseline": "depcruise-baseline . --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@mantine/core": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "@mantine/modals": "^9.8.0",
    "@mantine/notifications": "^9.8.0",
    "@tabler/icons-react": "^3.51.0",
    "@tanstack/markdown": "^1.2.0",
    "@tanstack/react-query": "^5.108.4",
    "compromise": "^14.20.0",
    "keyword-extractor": "^0.3.2",
    "mustache": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/chrome": "^0.3.7",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dependency-cruiser": "^18.9.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.95.0",
    "postcss": "^8.5.32",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
